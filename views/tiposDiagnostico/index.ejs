<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tipos de Diagnostico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">HospitalDB</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" href="/pacientes">Pacientes</a></li>
                <li class="nav-item"><a class="nav-link" href="/hospitalizaciones">Hospitalizaciones</a></li>
                <li class="nav-item"><a class="nav-link" href="/salas">Salas</a></li>
                <li class="nav-item"><a class="nav-link active" href="/tiposdiagnostico">Tipos de Diagnostico</a></li>
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <h1 class="mb-4">Lista de Tipos de Diagnostico</h1>
    <div class="mb-3">
        <a href="/tiposdiagnostico/nuevo" class="btn btn-primary btn-sm">Nuevo Tipo</a>
    </div>
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% tipos.forEach(t => { %>
                <tr>
                    <td><%= t.id %></td>
                    <td><%= t.nombre %></td>
                    <td>
                        <a href="/tiposdiagnostico/<%= t.id %>/editar" class="btn btn-success btn-sm">Editar</a>
                        <form action="/tiposdiagnostico/<%= t.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirm('Seguro que quieres eliminar este tipo?')">
                            <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>