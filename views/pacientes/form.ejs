<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Paciente</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="bg-light">
<div class="container mt-4">
    <h1 class="mb-4"><%= accion === 'editar' ? 'Editar' : 'Nuevo' %> Paciente</h1>
    <form action="/pacientes<%= accion === 'editar' ? '/' + paciente.id + '?_method=PUT' : '' %>" method="POST">
        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input type="text" name="nombre" class="form-control" value="<%= paciente ? paciente.nombre : '' %>">
        </div>
        <div class="mb-3">
            <label class="form-label">Apellido</label>
            <input type="text" name="apellido" class="form-control" value="<%= paciente ? paciente.apellido : '' %>">
        </div>
        <div class="mb-3">
            <label class="form-label">Diagnostico</label>
            <input type="text" name="diagnostico" class="form-control" value="<%= paciente ? paciente.diagnostico : '' %>">
        </div>
        <button type="submit" class="btn btn-primary">
            <%= accion === 'editar' ? 'Guardar cambios' : 'Crear paciente' %>
        </button>
        <a href="/pacientes" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>